---
import CalendarIcon from "../Icons/Calendar.astro";

interface Props {
    title: string;
    description: string;
    date: string;
    link?: string;
    latest: boolean;
}

const { title, description, date, link, latest } = Astro.props;
---

<li class="mb-10 ms-6">
    <span
        class="absolute flex items-center justify-center w-4 h-4 bg-blue-100 rounded-full -start-3 ring-8 ring-white dark:ring-gray-900 dark:bg-blue-900"
    >
        <CalendarIcon />
    </span>
    <h3
        class="flex items-center mb-1 text-lg font-semibold text-yellow-200 dark:text-yellow"
    >
        {title}
        {
            latest && (
                <span class="bg-blue-100 text-blue-800 text-sm font-medium me-2 px-2.5 py-0.5 rounded dark:bg-blue-900 dark:text-blue-300 ms-3">
                    Latest
                </span>
            )
        }
    </h3>
    <time
        class="block mb-2 text-sm font-normal leading-none text-sky-200/90 dark:text-sky-300/90"
        >{date}</time
    >
    <p
        class="mb-4 text-base font-normal text-gray-300 dark:text-gray-200 text-pretty"
    >
        {description}
    </p>
    {
        link && (
            <a
                href={link}
                class="inline-flex items-center px-4 py-2 text-sm font-medium text-gray-900 bg-white border border-gray-200 rounded-lg hover:bg-gray-100 hover:text-blue-700 focus:z-10 focus:ring-4 focus:outline-none focus:ring-gray-100 focus:text-blue-700 dark:bg-gray-800 dark:text-gray-400 dark:border-gray-600 dark:hover:text-white dark:hover:bg-gray-700 dark:focus:ring-gray-700"
            >
                Saber más{" "}
                <svg
                    class="w-3 h-3 ms-2 rtl:rotate-180"
                    aria-hidden="true"
                    xmlns="http://www.w3.org/2000/svg"
                    fill="none"
                    viewBox="0 0 14 10"
                >
                    <path
                        stroke="currentColor"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M1 5h12m0 0L9 1m4 4L9 9"
                    />
                </svg>
            </a>
        )
    }
</li>
