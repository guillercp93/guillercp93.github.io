---
import { Image } from "astro:assets";
import { TAGS } from "../Utils/tags.astro";
const PROYECTOS = [
    {
        titulo: "Music Player",
        descripcion:
            "Un reproductor de música multiplataforma desarrollado con Electron, React, Redux y NeDB. Es multiplataforma, lo que significa que puedes usarlo en Windows, macOS y Linux.",
        enlace: "https://www.google.com",
        repositorio: "https://github.com/guillercp93/music-player",
        imagen: "https://raw.githubusercontent.com/guillercp93/music-player/master/public/images/preview.png",
        tags: [
            TAGS.ELECTRON,
            TAGS.JAVASCRIPT,
            TAGS.REACT,
            TAGS.REDUX,
            TAGS.NEDB,
        ],
    },
];
---

{
    PROYECTOS.map(
        ({ titulo, descripcion, enlace, repositorio, imagen, tags }) => (
            <article>
                <h3 class="text-2xl font-semibold text-yellow-200 mb-2">
                    {titulo}
                </h3>
                <p class="text-lg mb-4 text-pretty">{descripcion}</p>
                <a href={enlace}>{enlace}</a>
                <a href={repositorio}>{repositorio}</a>
                <ul class="flex gap-x-4 flex-row my-4">
                    {tags.map((tag) => (
                        <li>
                            <span
                                class={`flex gap-x-2 rounded-full text-sm py-0.5 px-2.5 ${tag.className}`}
                            >
                                {tag.iconElement !== null ? (
                                    <tag.iconElement class="size-5" />
                                ) : (
                                    tag.name
                                )}
                            </span>
                        </li>
                    ))}
                </ul>
                <Image
                    class="rounded shadow-2xl shadow-white/20"
                    src={imagen}
                    alt={`Captura de pantalla de ${titulo}`}
                    width={800}
                    height={600}
                />
            </article>
        ),
    )
}
