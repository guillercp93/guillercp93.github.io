<section
    id={Astro.props.id}
    class={`${Astro.props.class ?? ""} w-full lg:w-[740px] mx-auto pb-24`}
>
    {
        Astro.props.titulo && (
            <h2 class="text-2xl semi-bold mb-6 flex flex-row gap-x-3 items-center">
                <Astro.props.icono class="size-8" />
                <span>{Astro.props.titulo}</span>
            </h2>
        )
    }
    <slot />
</section>
