---
import ElectronIcon from "../Icons/Electron.astro";
import JavaScriptIcon from "../Icons/JavaScript.astro";
import ReactIcon from "../Icons/React.astro";
import ReduxIcon from "../Icons/Redux.astro";

export const TAGS = {
    ELECTRON: {
        name: "Electron",
        className: "bg-cyan-950/75 text-white",
        iconElement: ElectronIcon,
    },
    JAVASCRIPT: {
        name: "JavaScript",
        className: "bg-yellow-300 text-white-200",
        iconElement: JavaScriptIcon,
    },
    REACT: {
        name: "React",
        className: "bg-white text-blue-200",
        iconElement: ReactIcon,
    },
    REDUX: {
        name: "Redux",
        className: "bg-purple-200/75 text-white",
        iconElement: ReduxIcon,
    },
    NEDB: {
        name: "Nedb",
        className: "bg-green-500",
        iconElement: null,
    },
};
---
