---
import { profile } from '../data/profile';

const year = new Date().getFullYear();
---

<footer>
  <div class="container inner">
    <p>© {year} {profile.name}</p>
  </div>
</footer>

<style>
  footer {
    border-top: 1px solid var(--border);
    padding-block: 28px;
    color: var(--muted);
    font-size: 0.88rem;
  }

  .inner {
    display: flex;
    justify-content: center;
  }
</style>
