---
import Icon from './Icon.astro';
import TechIcon from './TechIcon.astro';
import { profile, projects } from '../data/profile';
---

<section id="proyectos" class="section">
  <div class="container">
    <div class="section-head reveal">
      <p class="eyebrow">03 · proyectos</p>
      <h2 class="section-title">Proyectos personales</h2>
    </div>
    <ul class="grid">
      {
        projects.map((project) => (
          <li class="reveal">
            <article class="card project">
              <div class="top">
                <span class="folder" aria-hidden="true">{'{ }'}</span>
                <div class="links">
                  <a href={project.repo} target="_blank" rel="noopener noreferrer" aria-label={`Código de ${project.name} en GitHub`}>
                    <Icon name="github" />
                  </a>
                  {project.demo && (
                    <a href={project.demo} target="_blank" rel="noopener noreferrer" aria-label={`Ver demo de ${project.name}`}>
                      <Icon name="external" />
                    </a>
                  )}
                </div>
              </div>
              <h3>
                <a href={project.repo} target="_blank" rel="noopener noreferrer">
                  {project.name}
                </a>
              </h3>
              <p>{project.description}</p>
              <ul class="stack" aria-label="Tecnologías">
                {project.stack.map((tech) => (
                  <li class="chip">
                    <TechIcon name={tech} />
                    {tech}
                  </li>
                ))}
              </ul>
            </article>
          </li>
        ))
      }
    </ul>
    <div class="more reveal">
      <a class="btn btn-ghost" href={profile.github} target="_blank" rel="noopener noreferrer">
        <Icon name="github" /> Ver más en GitHub
      </a>
    </div>
  </div>
</section>

<style>
  .grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 20px;
  }

  @media (min-width: 640px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1000px) {
    .grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .grid > li {
    display: flex;
  }

  .project {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 24px;
    width: 100%;
    transition: transform 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease;
  }

  .project:hover {
    transform: translateY(-4px);
    border-color: rgba(34, 211, 238, 0.45);
    box-shadow: 0 20px 50px -25px rgba(34, 211, 238, 0.45);
  }

  .top {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .folder {
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 1.1rem;
    color: var(--accent);
  }

  .links {
    display: flex;
    gap: 12px;
    color: var(--muted);
  }

  .links a {
    position: relative;
    z-index: 1;
    transition: color 0.2s ease;
  }

  .links a:hover {
    color: var(--accent);
  }

  h3 {
    font-size: 1.15rem;
    font-weight: 700;
  }

  h3 a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  p {
    color: var(--muted);
    font-size: 0.95rem;
    flex-grow: 1;
  }

  .stack {
    list-style: none;
    margin: 4px 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .more {
    display: flex;
    justify-content: center;
    margin-top: 36px;
  }

  @media (prefers-reduced-motion: reduce) {
    .project:hover {
      transform: none;
    }
  }
</style>
