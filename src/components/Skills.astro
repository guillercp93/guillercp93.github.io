---
import TechIcon from './TechIcon.astro';
import { skills } from '../data/profile';
---

<section id="habilidades" class="section">
  <div class="container">
    <div class="section-head reveal">
      <p class="eyebrow">04 · habilidades</p>
      <h2 class="section-title">Stack tecnológico</h2>
    </div>
    <div class="groups">
      {
        skills.map((group) => (
          <div class="card group reveal">
            <h3>{group.group}</h3>
            <ul>
              {group.items.map((item) => (
                <li>
                  <TechIcon name={item} />
                  {item}
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .groups {
    display: grid;
    gap: 16px;
  }

  @media (min-width: 640px) {
    .groups {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1000px) {
    .groups {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .group {
    padding: 22px;
  }

  h3 {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--accent-2);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 14px;
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  li {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 7px 14px;
    border-radius: 10px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--border);
    font-weight: 500;
    font-size: 0.92rem;
    transition: border-color 0.2s ease, color 0.2s ease;
  }

  li:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
</style>
