---
import TechIcon from '@/components/TechIcon.astro';
import { localize, toLocale, useTranslations, type Localized } from '@/i18n/utils';

interface Props {
  items: Localized[];
}

const { items } = Astro.props;
const locale = toLocale(Astro.currentLocale);
const t = useTranslations(locale);
---

<ul class="stack" aria-label={t.tech}>
  {
    items.map((tech) => (
      <li class="chip">
        <TechIcon name={localize(tech, 'es')} />
        {localize(tech, locale)}
      </li>
    ))
  }
</ul>

<style>
  .stack {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
</style>
